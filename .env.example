# Copy to server/.env (do not commit .env).
# Values below are placeholders only.

# --- App ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=medicalindex
PINECONE_ENV=us-east-1

# --- LangSmith (observability) ---
# Dashboard: https://smith.langchain.com
# Modern flags (preferred):
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-ai-assistant
# EU / APAC accounts only (no trailing slash):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGCHAIN_TRACING_V2=true is still accepted as an alias for LANGSMITH_TRACING.
